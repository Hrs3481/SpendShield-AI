# Copy to backend/.env and fill in. Never commit the real .env — it is gitignored.

APP_NAME=SpendShield AI
ENV=development

# Local Postgres via docker compose. Any SQLAlchemy URL works.
DATABASE_URL=postgresql+psycopg://spendshield:spendshield@db:5432/spendshield

# Required when ENV=production; startup refuses to boot with the dev default.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=insecure-development-secret-do-not-use-in-production-0000
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Copilot. Leave LLM_API_KEY empty to run everything except the chat endpoint,
# which then returns a clear 503 instead of failing obscurely.
LLM_PROVIDER=anthropic
LLM_MODEL_NAME=claude-opus-5
LLM_API_KEY=
LLM_MAX_TOKENS=4096

# JSON array or a plain comma-separated list — both are accepted.
CORS_ORIGINS=["http://localhost:5173"]

AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Lets anyone create a pre-populated throwaway account. Disable for real deployments.
DEMO_MODE_ENABLED=true
